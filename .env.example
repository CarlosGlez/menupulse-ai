# Copia este archivo como .env.local y llena los valores de TU proyecto de Supabase
# (Project Settings → API). NUNCA subas .env.local a GitHub.

# Públicas (se pueden exponer al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA — solo servidor. Sin prefijo NEXT_PUBLIC_. (secret key o service_role)
SUPABASE_SECRET_KEY=

# Código para entrar al panel de administración/simulación (elige uno largo).
ADMIN_ACCESS_CODE=
